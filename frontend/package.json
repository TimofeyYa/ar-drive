    "@snack-uikit/code-editor": "^0.5.0",
    "@snack-uikit/drop-zone": "^0.6.0",
    "@snack-uikit/fields": "^0.20.0",
    "@snack-uikit/figma-tokens": "^1.10.0",
    "@snack-uikit/icons": "^1.30.0",
    "@snack-uikit/loaders": "^0.6.0",
    "@snack-uikit/markdown": "^0.6.0",
    "@snack-uikit/modal": "^0.10.0",
    "@snack-uikit/notification": "^0.10.0",
    "@snack-uikit/progress-bar": "^0.5.0",
    "@snack-uikit/table": "^0.30.0",
