# =========================================================================
# AR Drive — пример .env. Скопируйте: cp .env.example .env и отредактируйте.
# =========================================================================

# ---- Backend ----
LISTEN_ADDR=:8080
LOG_LEVEL=info                  # debug | info | warn | error
ENV=development                 # development | production

# Хранилище состояния (SQLite, pure-Go, без CGO)
DB_PATH=/data/app.db

# URLs Cloud.ru
CLOUDRU_IAM_URL=https://iam.api.cloud.ru
CLOUDRU_AR_URL=https://ar.api.cloud.ru

# CORS — список разрешённых origin'ов через запятую
CORS_ORIGINS=http://localhost:3000

# Rate-limit (запросов в минуту)
RATE_LIMIT_GLOBAL_RPM=100       # на IP, любые ручки
RATE_LIMIT_UPLOAD_RPM=30        # на пользователя, /files/upload
RATE_LIMIT_AUTH_RPM=5           # на IP, /api/v1/auth/verify

# Секрет для подписи cookie-сессий и share-links (HMAC-SHA256)
# Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=change-me-please-32-bytes-hex
SHARE_LINK_SECRET=change-me-please-32-bytes-hex

# Лимит размера загружаемого файла (байты). Cloud.ru AR ограничивает 1 GiB.
MAX_UPLOAD_BYTES=1073741824

# TTL кеша IAM-токена в секундах (срок жизни токена 3600s, кешируем -60s)
TOKEN_CACHE_SAFETY_MARGIN_SEC=60

# Включить эмиссию /metrics (Prometheus)
METRICS_ENABLED=true

# Опционально: Redis для распределённого rate-limit. Пусто = in-memory.
REDIS_ADDR=

# ---- Frontend (build-time, прокидываются в Vite) ----
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LOCALE=ru
